# .gitignore
# ------------------------------------------------------------
# Files and folders that should NOT be pushed to GitHub.
# ------------------------------------------------------------

# Environment variables — contains real DB credentials
.env

# Python cache files
__pycache__/
*.pyc
*.pyo

# Virtual environment folders (if used)
venv/
env/
.venv/

# IDE/editor folders
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
